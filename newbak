# pylint: disable=too-many-branches,too-many-statements,too-many-return-statements
"""
newbak - Configurable Incremental Backup Automation Tool

Automates incremental backups of a local Linux system onto multiple connected volumes
Highly configurable via easy (to edit + understand) newback-conf.yaml file.

Supports LUKS-encrypted disks, incremental backups (via rsnapshot), and more.

Also supports useful granular operations:
    - on/off: bring devices online/offline
    - open/close (unlock/lock) encryption
    - fsck: file-system check
    - mount/umount
    - full backup (optionally all the above)
"""
import sys
import subprocess
import os
import datetime
import json
import re
import getpass
from pathlib import Path
import yaml

# --- Constants and Configuration ---
LOG_FILE = 'newbak.log'
DEFAULT_ROTATION = 'hourly'
ALLOWED_PERIODS = ['hourly', 'daily', 'weekly', 'monthly']
MAIN_COMMANDS = ['backup', 'close', 'open', 'force-open', 'fsck', 'mount', 'umount', 'on', 'off', 'help' ]
UUID_REGEX = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', re.IGNORECASE)
CONFIG_PATHS = [
    Path('.'),
    Path('~/.config/newbak').expanduser()
]
CONFIG_FILE_NAME = 'newbak-conf.yaml'
DEBUG = False

# pylint: disable=redefined-builtin
def log_operation(message, type='INFO'):
    """Log a message with a strict timestamp format to the LOG_FILE."""
    timestamp = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')

    # Determine the prefix based on the type for the required log format
    if type == 'START':
        prefix = ' ,----- '
    elif type == 'END':
        prefix = ' `----- '
    else:
        prefix = ' | '

    log_entry = f"{timestamp}{prefix}{message}\n"
    print(log_entry, end='')

    try:
        with open(LOG_FILE, 'a', encoding='utf8') as f:
            f.write(log_entry)
    except Exception as e:
        print(f"{timestamp} | ERROR: Failed to write to log file {LOG_FILE}: {e}", file=sys.stderr)


def abort(message, command_line=None):
    """Log an error message and exit the script."""
    log_operation(f"ERROR: {message}", 'ERROR')
    if command_line:
        log_operation(command_line + ' ended', 'END')
    sys.exit(1)


def dbg(message):
    """Debugging function"""
    print(message)


def parse_args(args):
    """
    Handle argument parsing for command and target.
    The 'backup' command is assumed if the first argument is not a known command.
    """
    command, target_id, rotation = None, None, None
    # pylint: disable=global-statement
    global DEBUG

    if not args:
        return 'help', None, None

    for arg in args:
        arglower =  arg.lower()
        if arglower in ('-d', '-debug', '--debug'):
            DEBUG = True
            continue

        if arglower in MAIN_COMMANDS:
            if command:
                abort(f"multiple commands given: {command} {arg}")
            command = arglower
            continue

        if arglower in ALLOWED_PERIODS:
            command = 'backup'
            rotation = arglower
            continue

        if target_id:
            abort(f"multiple target_ids given: {target_id} {arg}")

        target_id = arg


    if command == 'help':
        return 'help', None, None

    if not target_id:
        abort(f"Command '{command}' requires a target volume (name or UUID).")

    if not command:
        # implied
        command = 'backup'

    if command == 'backup' and not rotation:
        rotation = DEFAULT_ROTATION

    return command, target_id, rotation


def print_usage(config):
    """Print usage guide."""
    print("Usage: newbak [backup] <name|UUID> [rotation]")
    print("       newbak <command> <name|UUID>")
    print("\nCommands:")
    print("  backup <target> [rotation]  Full cycle: [on], open, mount, rsnapshot, umount, close, [off]")
    print("  open <target>               LUKS open (with optional [on]) only")
    print("  force-open <target>         Close existing maps on device, then open")
    print("  close <target>              Unmount and LUKS close (with optional [off])")
    print("  fsck <target>               Filesystem check (must be open but inactive/unmounted)")
    print("  on <target>                 Bring device online (turn on)")
    print("  off <target>                Take device offline (turn off)")
    print("  mount <target>              Mount volume (must be open)")
    print("  umount <target>             Unmount volume (must be open & mounted)")
    print("  help                        Show this guide")
    print("\nAvailable Targets:")
    for name, info in config.get('backups', {}).items():
        print(f"  {name:<15} (UUID: {info.get('uuid', 'N/A')}, Mount: {info.get('mountpoint', 'N/A')})")
    sys.exit(0)


def find_config_file():
    """Search for CONFIG_FILE_NAME in the specified paths."""
    for path in CONFIG_PATHS:
        config_path = path / CONFIG_FILE_NAME
        if config_path.is_file():
            log_operation(f"Loaded configuration from: {config_path}", 'INFO')
            return config_path
    return None


# pylint: disable=inconsistent-return-statements
def load_config(config_path):
    """Load and validate the backup configuration from the YAML file."""
    try:
        with open(config_path, 'r', encoding='latin1') as f:
            config = yaml.safe_load(f)
        if 'backups' not in config:
            raise ValueError(f"{config_path}: 'backups' key missing.")
        return config
    except Exception as e:
        abort(f"{config_path}: configuration error: {e}")


def substitute_template(command_list, context):
    """Substitute ${variables} wherever they appear in command list elements."""
    if not command_list or not isinstance(command_list, list):
        return None

    substituted_list = []
    for item in command_list:
        if not isinstance(item, str):
            substituted_list.append(item)
            continue

        new_item = item
        for var_name, var_value in context.items():
            placeholder = f'${{{var_name}}}'
            new_item = new_item.replace(placeholder, str(var_value))

        # Sanity check for plausible user-error: do we have any unsubstituted items?
        if m := re.search(r'\$\{[^{}]*\}', new_item):
            abort(f"Config error for volume {context['volname']}: undefined variable: {m.group(0)}")

        substituted_list.append(new_item)

    return substituted_list


# pylint: disable=too-many-arguments
def run_command(command_list,
                check=True,
                log_output=False,
                capture_output=True,
                stderr_ok_re=None,
                input_data=None):
    """
    Execute a shell command using subprocess.
    Does error handling & logging.
    Support error override via 'stderr_ok_re': a stderr matching RegEx to consider a success
    """
    if not command_list or not isinstance(command_list, list):
        raise TypeError("Configuration Error: A required command list is missing or invalid.")

    result = None
    cmd_str = ' '.join(command_list)
    log_operation(f"Executing: {cmd_str}")

    try:
        result = subprocess.run(
            command_list,
            check=check,
            capture_output=capture_output,
            text=True,
            input=input_data
        )
        if log_output and result.stdout:
            for line in result.stdout.strip().split('\n'):
                log_operation(line, type='DEVICE')
        if DEBUG: dbg(f"run_command: all successful. returning result={result}")
        return result
    except subprocess.CalledProcessError as e:
        if DEBUG: dbg(f"run_command: exception hit: {e}. stderr={e.stderr}")

        if e.stderr:
            if stderr_ok_re:
                if m := re.search(stderr_ok_re, e.stderr):
                    log_operation(f"Command success override: stderr match: '{m.group(0)}')", type='INFO')
                    return e
            else:
                for line in e.stderr.strip().split('\n'):
                    log_operation(line, type='ERROR')

                log_operation(f"Command failed (Exit Code {e.returncode})", 'ERROR')
        raise

def get_device_info(target_id, full_config):
    """
    Find physical device path for target_id
    Retrieve the target_id context from full_config
    Finally, return the expanded context which includes:
        - volname
        - device
    """
    config = full_config['backups']
    volume_name = None

    if target_id in config:
        info = config[target_id].copy()
        volume_name = target_id
    else:
        info = next((v.copy() for k, v in config.items() if v.get('uuid') == target_id), None)
        volume_name = next((k for k, v in config.items() if v.get('uuid') == target_id), None)

    if not info:
        avail_names = ' '.join(config.keys())
        abort(f"Target '{target_id}' not found in configuration: available names: {avail_names}")

    context = full_config.copy()
    context.update(info)
    context['volname'] = volume_name

    for key in ['uuid', 'mountpoint', 'rsnapshotconf', 'luks_mapname']:
        if key not in context:
            abort(f"Config for '{volume_name}' missing key: '{key}'")

    # Devices that need turn on/off, must be brought online first
    # otherwise they won't appear in 'lsblk' output
    if context.get('on_command'):
        # Alas: may need both turn-on + open, but this is a chicken/egg issue
        # We can't do 'open' without knowing the device and there's no device before open :-(
        turn_on(context)

    cmd = ['lsblk', '-J', '-o', 'NAME,UUID,TYPE']
    result = run_command(cmd, check=True, capture_output=True)
    lsblk_data = json.loads(result.stdout)

    def find_device(nodes):
        for node in nodes:
            if str(node.get('uuid', '')).lower() == context['uuid'].lower() and node.get('type') == 'part':
                return f"/dev/{node['name']}"
            if 'children' in node:
                path = find_device(node['children'])
                if path:
                    return path
        return None

    device_path = find_device(lsblk_data.get('blockdevices', []))
    if not device_path:
        abort(f"No physical device found for {target_id}: UUID {context['uuid']}. Is it on?")

    context['device'] = device_path
    return context


def find_active_mapname(device_path):
    """Finds active device mapper name associated with physical LUKS path."""
    cmd = ['lsblk', '-J', '-o', 'NAME,KNAME,PKNAME,TYPE']
    try:
        result = subprocess.run(cmd, check=True, capture_output=True, text=True)
        lsblk_data = json.loads(result.stdout)
    except Exception:
        return None

    target_kname = Path(device_path).name

    def search_children(nodes):
        for node in nodes:
            if node.get('kname') == target_kname and node.get('type') == 'part':
                if 'children' in node:
                    for child in node['children']:
                        if child.get('type') in ['crypt', 'dm']:
                            return child.get('name')
                return None
            if 'children' in node:
                map_name = search_children(node['children'])
                if map_name:
                    return map_name
        return None

    return search_children(lsblk_data.get('blockdevices', []))


def check_luks_status(luks_map_name):
    """Check if the LUKS device is currently open."""
    # This is buggy: tunring a dvice off/on loses the secrets (device is effectively closed)
    # 'cryptsetup status <luks_map_name>' says "<luks_map_name> is active and is in use."
    # but 'lsblk' shows no inner LUKS device (TYPE=crypt) so content can't be accessed
    cmd = ['cryptsetup', 'status', luks_map_name]
    try:
        result = subprocess.run(cmd, check=False, capture_output=True)
        return result.returncode == 0
    except Exception:
        return False


def is_mounted(mountpoint):
    """Check if mountpoint is active."""
    try:
        with open('/proc/mounts', 'r', encoding='latin1') as f:
            return any(line.split()[1] == mountpoint for line in f.readlines())
    except Exception:
        return False


def is_open(volname):
    """Check if a volume is open (luks encryption unlocked)."""
    cmd = ['lsblk', '-o', 'NAME,TYPE']          # external command we run
    openvol_re = f'\\b{volname}\\s+crypt$'      # pattern we're looking for (success)
    try:
        result = run_command(cmd, check=False, capture_output=True)
        lines = result.stdout.strip().split('\n')
        for line in lines:
            if re.search(openvol_re, line):
                return True

        if DEBUG: dbg(f"is_open({volname}): success but device isn't open! Returning False")
        return False

    except Exception as e:
        if DEBUG: dbg(f"is_open({volname}): exception {e}")
        return False

def check_df_mount(mountpoint):
    """
    Verify a mount by looking at the mountpoint via 'df'.
    Similar to 'is_mounted', but also logs the matching 'df' line (example):
        /dev/mapper/evo860 ext4      1.8T  819G  921G  48% /media/evo860
    This 'df' output is critical for monitoring (Used%) of the mounted volume over time
    """
    try:
        cmd = ['df', '-TPh', mountpoint]
        result = run_command(cmd, check=True, capture_output=True)
        lines = result.stdout.strip().split('\n')
        if len(lines) >= 2:
            columns = lines[1].split()
            volsize_re = r'^\d+(\.\d+)?[KMGTPE]$'
            if re.match(volsize_re, columns[2], re.IGNORECASE):
                log_operation(f"\t{lines[1]}", 'INFO')
                return True
        return False
    except Exception as e:
        if DEBUG: dbg(f"check_df_mount({mountpoint}): {e}")
        return False


def turn_off(context):
    """
    Execute 'off' command.

    Always 'succeeds' (by doing nothing iff the device doesn't support the 'off_command')

    We can NOT check status of the on/off state beforehand because /sys/bus/usb/drivers/usb/unbind
    is a single write-only pseudo-device:
        --w------- 1 root root 4096 Feb  1 21:32 /sys/bus/usb/drivers/usb/unbind
    We can only check exit-status of the operation after the fact.
    A 'failure' when run as root means it was already at the wanted state.

    Always 'succeeds' (by doing nothing, or by idempotency)
    This is a safe (no-op) for any devices that don't explicitly configure an 'off_command'
    """
    raw_off_command = context.get('off_command')
    if not raw_off_command:
        # Volume doesn't have any 'off_command' configured.
        # IOW: device doesn't need to be brought online/offline (e.g. it is permanently connected)
        # Nothing to do: silent success
        return True

    off_cmd = substitute_template(raw_off_command, context)
    if run_command(off_cmd, check=True, log_output=True):
        log_operation("Device turned off.", 'INFO')
        return True

    # 'Failure' of command means it was already on
    log_operation("Device was already turned off.", 'INFO')
    return True


def turn_on(context):
    """
    Execute 'on' command for the volume, IFF configured for this context.

    We can NOT check status of the on/off state beforehand because /sys/bus/usb/drivers/usb/bind
    is a single write-only pseudo-device:
        --w------- 1 root root 4096 Feb  1 21:32 /sys/bus/usb/drivers/usb/bind
    We can only check exit-status of the operation after the fact.
    A 'failure' when run as root means it was already at the wanted state.

    This is a safe no-op for devices which don't explicitly configure an 'on_command'
    Always succeeds (either by doing nothing, or by idempotency)
    """
    raw_on_cmd = context.get('on_command')
    if not raw_on_cmd:
        # Configuration doesn't specify an 'on_command' for this context:
        #   i.e. device doesn't need to be brought online (e.g. it is permanently connected)
        # Nothing to do: silent success
        return True

    on_cmd = substitute_template(raw_on_cmd, context)
    if DEBUG: dbg(f"turn_on: after substitute_template: '{raw_on_cmd}' -> '{on_cmd}'")
    if run_command(on_cmd, check=True, stderr_ok_re='write error: Device or resource busy'):
        log_operation("Device turned on.", 'INFO')
        return True

    # 'Failure' of 'on' command that prints:
    #       write error: Device or resource busy
    # means the device was already on
    log_operation("Device was already turned on.", 'INFO')
    return True


def run_open_operation(context, command_line):
    """Handle the core LUKS open process."""
    # Must be on, iff (volume is offline && on_command is configured in context)
    if context.get('on_command'):
        turn_on(context)

    volname = context['volname']

    # -- 'check_luks_status' is unreliable.
    # -- Use the more reliable 'is_open' primitive (lsblk output)
    # luks_map_name = context['luks_mapname']
    # if check_luks_status(luks_map_name):
    #    log_operation(f"LUKS device '{luks_map_name}' is already open.", 'INFO')
    #    return True
    if is_open(volname):
        log_operation(f"volume '{volname}' is already LUKS open.", 'INFO')
        return True

    try:
        passphrase = getpass.getpass(f"Passphrase for {volname}: ")
        input_data = passphrase + '\n'
    except EOFError:
        abort("Passphrase input failed.", command_line)

    try:
        open_cmd = substitute_template(context.get('open_command'), context)
        run_command(open_cmd, check=True, input_data=input_data)
        log_operation("LUKS device successfully opened.", 'INFO')
        return True
    except subprocess.CalledProcessError as e:
        if 'already mapped' in e.stderr:
            log_operation("LUKS open failed: Device busy. Try 'force-open'.", 'ERROR')
            return False
        abort("LUKS open failed. Check passphrase.", command_line)
    return False


def run_umount_operation(context, command_line):
    """fail-safe/idempotent un-mount op"""
    mountpoint = context['mountpoint']
    if not is_mounted(mountpoint):
        # fail-safe: when not mounted, this is a safe no-op.
        return

    try:
        # log_operation(f"Attempting to umount {mountpoint}.", 'INFO')
        umount_cmd = substitute_template(context.get('umount_command'), context)
        run_command(umount_cmd, check=True)
    except subprocess.CalledProcessError:
        abort("Aborting due to umount failure.", command_line)


def run_mount_operation(context, command_line):
    """fail-safe/idempotent mount op"""
    mountpoint = context['mountpoint']
    if is_mounted(mountpoint):
        log_operation(f"mount: {mountpoint} is already mounted")
        return

    try:
        # log_operation(f"Attempting to mount {mountpoint}.", 'INFO')
        mount_cmd = substitute_template(context.get('mount_command'), context)
        run_command(mount_cmd, check=True)
    except subprocess.CalledProcessError:
        abort("Aborting due to mount failure.", command_line)


def do_force_open(context, command_line):
    """
    Close conflicting system map then opens

    The system remembers/caches a LOT of info on each mapped device.
    See e.g. the output of:
        udevadm info /dev/mapper/evo970ext
    """
    active_map_name = find_active_mapname(context['device'])
    if active_map_name and active_map_name != context['luks_mapname']:
        log_operation(f"Closing conflicting map '{active_map_name}'.", 'WARNING')
        subprocess.run(['cryptsetup', 'close', active_map_name], check=True)
        #--do we want this too?--#
        run_command(['dmsetup', 'remove', active], check=False)

    if not run_open_operation(context, command_line):
        abort("Force-open failed.", command_line)


def run_close_operation(context, command_line):
    """Execute 'close' command."""
    luks_map_name = context['luks_mapname']
    # Not a reliable check, commented out
    # if not check_luks_status(luks_map_name):
    #    return
    volname = context['volname']
    if not is_open(volname):
        # Already closed...
        turn_off(context)       # make sure the device is turned-off (if supported)
        return

    # Device is open and needs closing. First, make sure it is unmounted
    run_umount_operation(context, command_line)

    close_cmd = substitute_template(context.get('close_command'), context)
    run_command(close_cmd, check=False)

    if check_luks_status(luks_map_name):
        abort("LUKS close failed.", command_line)
    log_operation("LUKS device closed.", 'INFO')

    # Optionally turn-off device
    turn_off(context)


def do_fsck(context, command_line):
    """Execute fsck."""
    luks_map_name = context['luks_mapname']
    volname = context['volname']
    # if not check_luks_status(luks_map_name):
    if not is_open(volname):
        log_operation(f"Opening {luks_map_name} for fsck...")
        if not run_open_operation(context, command_line):
            abort("Could not open LUKS device.", command_line)

        context['opened-by-script'] = True

    run_umount_operation(context, command_line)

    fsck_cmd = substitute_template(context.get('fsck_command'), context)
    if not fsck_cmd:
        abort("fsck_command not defined in configuration.", command_line)

    try:
        run_command(fsck_cmd, check=True, log_output=True)
        log_operation("fsck completed successfully.")

        if context.get('opened-by-script'):
            run_close_operation(context, command_line)

    except subprocess.CalledProcessError as e:
        if e.returncode == 1:
            log_operation("fsck corrected filesystem errors.", 'WARNING')
        else:
            abort(f"fsck failed (Exit Code {e.returncode})", command_line)


def do_backup(context, command_line):
    """Execute full backup workflow."""
    luks_map_name = context['luks_mapname']
    mountpoint = context['mountpoint']
    context['opened-by-script'] = False         # Was: opened_by_script = False

    if is_mounted(mountpoint):
        abort(f"Target {mountpoint} is already mounted.", command_line)

    if not check_luks_status(luks_map_name):
        if run_open_operation(context, command_line):
            context['opened-by-script'] = True
        else:
            abort("LUKS open failed.", command_line)

    os.makedirs(mountpoint, exist_ok=True)
    mount_cmd = substitute_template(context.get('mount_command'), context)
    try:
        run_command(mount_cmd, check=True)
        # Log how full the volume is (Use%)
        if not check_df_mount(mountpoint):
            abort("Mount failure (no 'df' line).", command_line)
    except Exception:
        if context.get('opened-by-script'):
            run_command(substitute_template(context.get('close_command'), context), check=False)
        abort("Mount failure.", command_line)

    try:
        rsnapshot_cmd = substitute_template(context.get('rsnapshot_command'), context)
        run_command(rsnapshot_cmd, check=True, log_output=False)
        log_operation("Rsnapshot completed successfully.")

    except Exception:
        log_operation("Rsnapshot failed.", 'ERROR')

    run_umount_operation(context, command_line)

    if context.get('opened-by-script'):
        # includes optional/no-op turn_off
        run_close_operation(context, command_line)


def main():
    """Main Function"""
    if os.geteuid() != 0:
        log_operation("Re-executing with sudo...")
        os.execvp('sudo', ['sudo'] + sys.argv)

    command, target_id, rotation = parse_args(sys.argv[1:])
    config_path = find_config_file()
    if not config_path:
        abort(f"Configuration file '{CONFIG_FILE_NAME}' not found in search paths.")

    full_config = load_config(config_path)
    if command == 'help':
        print_usage(full_config)

    context = get_device_info(target_id, full_config)
    context['rotation'] = rotation
    command_line = f"newbak {' '.join(sys.argv[1:])}"

    log_operation(command_line, 'START')
    if command == 'fsck':
        do_fsck(context, command_line)
    elif command == 'mount':
        run_mount_operation(context, command_line)
    elif command == 'umount':
        run_umount_operation(context, command_line)
    elif command == 'open':
        run_open_operation(context, command_line)
    elif command == 'force-open':
        do_force_open(context, command_line)
    elif command in ('close', 'off'):
        # 'close' means no more encrypted-volume dev-mapping,
        #         for offline devices, this implies a (configurable) turn-off
        #         which is a safe no-op for devices that don't support it.
        # 'off' means a complete take-offline. Implies: [[umount] close] off
        run_umount_operation(context, command_line)
        run_close_operation(context, command_line)
    elif command == 'backup':
        do_backup(context, command_line)

    log_operation(command_line + ' ended', 'END')

if __name__ == "__main__":
    main()
